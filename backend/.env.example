# ============================================================================
# Lost & Found Campus — backend environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

APP_NAME="Lost & Found Campus API"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Security (REQUIRED) ----------------------------------------------------
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-64-character-random-secret-value-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
PASSWORD_RESET_EXPIRE_MINUTES=60
PBKDF2_ITERATIONS=240000
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# --- MySQL ------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lfc_app
DB_PASSWORD=change-me
DB_NAME=lost_found_campus
DB_POOL_SIZE=8

# --- Files ------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_REPORT=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOC_TYPES=image/jpeg,image/png,image/webp,application/pdf

# --- URLs / CORS ------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
CORS_ORIGIN_REGEX=https?://([a-zA-Z0-9-]+\.)*(e2b\.app|arena\.ai)(:\d+)?$

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REPORT=20/hour
RATE_LIMIT_DEFAULT=240/minute

# --- SMTP (optional; falls back to email_log when blank) --------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
EMAIL_FALLBACK_TO_LOG=true

# --- Behaviour --------------------------------------------------------------
DEFAULT_UNIVERSITY_CODE=ALDU
TRUST_PROXY_HEADERS=true
